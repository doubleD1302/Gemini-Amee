{
  "name": "gemini-project-studio",
  "version": "0.2.0",
  "private": true,
  "description": "Antigravity-style local coding agent desktop app driven by Gemini Web through an opt-in Chrome extension.",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "local.geminiprojectstudio.app",
    "productName": "Gemini Project Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "public/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gemini Project Studio",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      },
      {
        "from": "HUONG_DAN_NHANH.html",
        "to": "HUONG_DAN_NHANH.html"
      }
    ],
    "publish": null,
    "portable": {
      "artifactName": "${productName} ${version} Portable.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/doubleD1302/Gemini-Amee.git"
  }
}
